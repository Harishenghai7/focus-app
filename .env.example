# ============================================================================
# 🛡️  FOCUS APP - ENVIRONMENT CONFIGURATION
# ============================================================================
# This file serves as a template for your environment variables.
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
# ============================================================================

# ========================
# 🏗️  APP CONFIGURATION
# ========================
NODE_ENV=development
REACT_APP_ENVIRONMENT=development
REACT_APP_VERSION=1.0.0
REACT_APP_API_TIMEOUT=30000  # API request timeout in ms
REACT_APP_DEFAULT_LOCALE=en

# ========================
# 🔐  SUPABASE CONFIGURATION
# ========================
# Get these values from your Supabase project settings -> API
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here
REACT_APP_SUPABASE_SERVICE_KEY=your-service-role-key-here  # Keep this secure!
REACT_APP_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# ========================
# 🔑  AUTHENTICATION
# ========================
# Session and token settings
REACT_APP_SESSION_TIMEOUT=86400  # 24 hours in seconds
REACT_APP_REFRESH_TOKEN_OFFSET=300  # 5 minutes before token expiry

# OAuth Providers - Configure in Supabase Authentication -> Providers
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_GITHUB_CLIENT_ID=your-github-client-id
REACT_APP_TWITTER_CLIENT_ID=your-twitter-client-id
REACT_APP_DISCORD_CLIENT_ID=your-discord-client-id
REACT_APP_MICROSOFT_CLIENT_ID=your-microsoft-client-id

# ========================
# 🛡️  SECURITY
# ========================
# Enable security features (true/false)
REACT_APP_ENABLE_2FA=true
REACT_APP_ENABLE_RATE_LIMITING=true
REACT_APP_ENABLE_CSP=true
REACT_APP_ENABLE_HSTS=true
REACT_APP_ENABLE_XSS_PROTECTION=true

# Security Headers
REACT_APP_CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;"

# ========================
# 📊  MONITORING & ANALYTICS
# ========================
REACT_APP_SENTRY_DSN=your-sentry-dsn
REACT_APP_GA_MEASUREMENT_ID=your-ga-id
REACT_APP_MIXPANEL_TOKEN=your-mixpanel-token
REACT_APP_LOGGING_LEVEL=info  # debug, info, warn, error

# ========================
# 📱  PUSH NOTIFICATIONS
# ========================
REACT_APP_VAPID_PUBLIC_KEY=your-vapid-public-key
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true
REACT_APP_NOTIFICATION_ICON=/notification-icon.png

# ========================
# 🗄️  STORAGE
# ========================
# File upload limits (in bytes)
REACT_APP_MAX_AVATAR_SIZE=2097152  # 2MB
REACT_APP_MAX_IMAGE_UPLOAD=5242880  # 5MB
REACT_APP_MAX_VIDEO_UPLOAD=104857600  # 100MB
REACT_APP_MAX_FILE_UPLOAD=26214400  # 25MB

# ========================
# 🔄  FEATURE FLAGS
# ========================
# Enable/disable features (true/false)
REACT_APP_FEATURE_STORIES=true
REACT_APP_FEATURE_DIRECT_MESSAGES=true
REACT_APP_FEATURE_VIDEO_CALLS=true
REACT_APP_FEATURE_GROUP_CHAT=true
REACT_APP_FEATURE_HIGHLIGHTS=true
REACT_APP_FEATURE_ANALYTICS=true

# ========================
# 🌍  LOCALIZATION
# ========================
REACT_APP_DEFAULT_TIMEZONE=UTC
REACT_APP_DATE_FORMAT=MM/DD/YYYY
REACT_APP_TIME_FORMAT=HH:mm

# ========================
# 🚀  PERFORMANCE
# ========================
REACT_APP_IMAGE_QUALITY=80  # 0-100
REACT_APP_LAZY_LOAD_OFFSET=200  # pixels from viewport to start loading
REACT_APP_DEBOUNCE_DELAY=300  # ms for search/input debouncing

# ========================
# 🧪  TESTING
# ========================
# Only for development/testing
REACT_APP_E2E_TESTING=false
REACT_APP_MOCK_API=false

# ========================
# 🔗  EXTERNAL SERVICES
# ========================
# Email service (e.g., SendGrid, Postmark)
REACT_APP_EMAIL_PROVIDER=sendgrid
REACT_APP_EMAIL_FROM=noreply@yourdomain.com

# CDN configuration
REACT_APP_CDN_BASE_URL=https://cdn.yourdomain.com

# ========================
# 📝  DOCUMENTATION
# ========================
# For detailed documentation on each configuration option, visit:
# https://docs.yourdomain.com/configuration