# Production Environment Variables
# These should be set in your deployment platform (Netlify, Vercel, etc.)

# App Configuration
REACT_APP_VERSION=0.1.0
REACT_APP_ENV=production

# Build Optimization
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
IMAGE_INLINE_SIZE_LIMIT=0

# Disable ESLint plugin during CI/production builds
# Vercel sets CI=true which turns all ESLint warnings into hard errors.
# This flag tells react-scripts to skip the ESLint webpack plugin entirely.
DISABLE_ESLINT_PLUGIN=true

# Note: Supabase and other sensitive variables should be set in deployment platform
# REACT_APP_SUPABASE_URL=your_production_supabase_url
# REACT_APP_SUPABASE_ANON_KEY=your_production_supabase_key
# REACT_APP_SENTRY_DSN=your_production_sentry_dsn