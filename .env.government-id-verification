# ============================================================================
# 🛡️  GOVERNMENT ID VERIFICATION - ENVIRONMENT CONFIGURATION
# ============================================================================
# Add these variables to your .env file
# ============================================================================

# ========================
# 🏛️  DIGILOCKER API
# ========================
# Apply for DigiLocker partnership at: https://www.digilocker.gov.in/web/partners/requesters
# For development, use sandbox credentials
REACT_APP_DIGILOCKER_CLIENT_ID=your_digilocker_client_id_here
REACT_APP_DIGILOCKER_REDIRECT_URI=http://localhost:3000/auth/digilocker/callback

# ========================
# 🔐  SUPABASE EDGE FUNCTIONS
# ========================
# These should be set in Supabase Dashboard → Edge Functions → Settings
# DIGILOCKER_CLIENT_ID=your_digilocker_client_id_here
# DIGILOCKER_SECRET=your_digilocker_client_secret_here
# DIGILOCKER_REDIRECT_URI=https://yourapp.com/auth/digilocker/callback
# APP_BASE_URL=https://yourapp.com

# ========================
# 📝  PRODUCTION NOTES
# ========================
# 1. Update REACT_APP_DIGILOCKER_REDIRECT_URI to your production domain
# 2. Update DIGILOCKER_REDIRECT_URI in Supabase Edge Functions
# 3. Download face-api.js models to public/models/ directory
# 4. Apply for DigiLocker production credentials (takes 7-14 days)
# 5. Run database migration: supabase db push
# 6. Deploy Edge Functions: supabase functions deploy
# ============================================================================
