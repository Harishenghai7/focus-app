.container {
    display: flex;
    height: 100vh;
    background: var(--bg-primary);
}

/* LEFT SIDE: Video Preview (50%) */
.previewWrapper {
    width: 50%;
    position: relative;
    background: black;
    display: flex;
    flex-direction: column;
    border-right: 2px solid var(--border-default);
}

.videoPreviewArea {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    overflow: hidden;
}

.videoContainer {
    position: relative;
    max-width: 100%;
    max-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.video {
    display: block;
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
    transition: filter 0.3s ease;
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
}

.overlayContainer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
}

.overlayItem {
    position: absolute;
    pointer-events: auto;
    cursor: move;
    user-select: none;
    transform-origin: center;
    border: 2px solid transparent;
    transition: border-color 0.2s, transform 0.1s;
}

.overlayItem:hover,
.overlayItem.active {
    border-color: var(--primary-lavender);
}

.overlayText {
    white-space: nowrap;
    text-shadow:
        0 2px 4px rgba(0, 0, 0, 0.8),
        0 0 10px rgba(0, 0, 0, 0.5);
    font-weight: bold;
}

.overlaySticker {
    width: 100px;
    height: 100px;
    object-fit: contain;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
}

.deleteBtn {
    position: absolute;
    top: -12px;
    right: -12px;
    background: var(--error);
    color: white;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid white;
    cursor: pointer;
    font-size: 16px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s;
}

.deleteBtn:hover {
    transform: scale(1.1);
}

.playOverlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    cursor: pointer;
    z-index: 10;
    animation: fadeIn 0.2s;
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

.previewFooter {
    padding: var(--space-3);
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.7) 100%);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.previewInfo {
    color: white;
    font-size: var(--font-sm);
    display: flex;
    gap: var(--space-3);
}

.previewInfo span {
    display: flex;
    align-items: center;
    gap: var(--space-1);
}

/* Bottom Bar */
.bottomBar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    padding: var(--space-4) var(--space-4);
    border-top: 1px solid var(--border-default);
    background: var(--bg-elevated);
    flex-shrink: 0;
    min-height: 100px;
}

/* RIGHT SIDE: Controls (50%) */
.controls {
    width: 50%;
    background: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.tabs {
    display: flex;
    overflow-x: auto;
    border-bottom: 1px solid var(--border-default);
    padding: 0 var(--space-2);
    scrollbar-width: none;
    background: linear-gradient(180deg, var(--bg-elevated) 0%, var(--bg-secondary) 100%);
    flex-shrink: 0;
}

.tabs::-webkit-scrollbar {
    display: none;
}

.tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: var(--font-xs);
    white-space: nowrap;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.tab::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 80%;
    height: 3px;
    background: var(--primary-lavender);
    border-radius: var(--radius-full);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab:hover {
    color: var(--text-primary);
    background: rgba(var(--primary-lavender-rgb), 0.05);
}

.tab.active {
    color: var(--primary-lavender);
    background: rgba(var(--primary-lavender-rgb), 0.1);
}

.tab.active::after {
    transform: translateX(-50%) scaleX(1);
}

.tabContent {
    flex: 1;
    padding: var(--space-4);
    overflow-y: auto;
    animation: slideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    scrollbar-width: thin;
    scrollbar-color: var(--primary-lavender) var(--bg-secondary);
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(10px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.tabContent::-webkit-scrollbar {
    width: 6px;
}

.tabContent::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: var(--radius-full);
}

.tabContent::-webkit-scrollbar-thumb {
    background: var(--primary-lavender);
    border-radius: var(--radius-full);
}

.helpText {
    font-size: var(--font-sm);
    color: var(--text-secondary);
    text-align: center;
    margin: var(--space-4) 0;
    padding: var(--space-3);
    background: rgba(var(--primary-lavender-rgb), 0.05);
    border-radius: var(--radius-md);
    border: 1px solid rgba(var(--primary-lavender-rgb), 0.1);
}

/* Trim Content */
.trimContent {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

/* Crop Content */
.cropContent {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
}

.aspectRatioButtons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
}

.ratioBtn {
    padding: var(--space-3);
    border: 2px solid var(--border-default);
    background: var(--bg-secondary);
    color: var(--text-primary);
    border-radius: var(--radius-md);
    font-size: var(--font-sm);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
}

.ratioBtn:hover {
    border-color: var(--primary-lavender);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(var(--primary-lavender-rgb), 0.2);
}

.ratioBtn.active {
    background: var(--primary-lavender);
    color: white;
    border-color: var(--primary-lavender);
    box-shadow: 0 4px 16px rgba(var(--primary-lavender-rgb), 0.4);
}

/* Filter Content with Previews */
.filterContent {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
}

.filterGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
}

.filterItem {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    padding: var(--space-2);
    border-radius: var(--radius-lg);
    border: 2px solid transparent;
    transition: all 0.2s;
    background: var(--bg-secondary);
}

.filterItem:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--primary-lavender-rgb), 0.5);
    box-shadow: 0 6px 16px rgba(var(--primary-lavender-rgb), 0.15);
}

.filterItem.active {
    background: linear-gradient(135deg,
            rgba(var(--primary-lavender-rgb), 0.15) 0%,
            rgba(var(--primary-lavender-rgb), 0.08) 100%);
    border-color: var(--primary-lavender);
    box-shadow: 0 4px 16px rgba(var(--primary-lavender-rgb), 0.3);
}

.filterPreview {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #1a1a1a;
    position: relative;
}

.filterPreview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.filterName {
    font-size: var(--font-xs);
    color: var(--text-secondary);
    font-weight: 600;
    text-align: center;
    line-height: 1.2;
}

.filterItem.active .filterName {
    color: var(--primary-lavender);
}

.filterIntensity {
    background: var(--bg-secondary);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    border: 2px solid var(--border-default);
}

/* Adjust Content */
.adjustContent {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.adjustHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
}

.adjustHeader h4 {
    font-size: var(--font-md);
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
}

.adjustSlider {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    transition: all 0.2s;
}

.adjustSlider:hover {
    border-color: var(--primary-lavender);
    box-shadow: 0 2px 8px rgba(var(--primary-lavender-rgb), 0.1);
}

.adjustLabel {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-sm);
    color: var(--text-secondary);
    font-weight: 500;
}

.adjustLabel span:last-child {
    color: var(--primary-lavender);
    font-weight: 600;
}

.rangeInput {
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    outline: none;
    transition: background 0.2s;
}

.rangeInput:hover {
    background: var(--bg-elevated);
}

.rangeInput::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--primary-lavender);
    cursor: pointer;
    box-shadow:
        0 2px 6px rgba(0, 0, 0, 0.2),
        0 0 0 4px rgba(var(--primary-lavender-rgb), 0.2);
    transition: all 0.2s;
}

.rangeInput::-webkit-slider-thumb:hover {
    transform: scale(1.2);
    box-shadow:
        0 3px 8px rgba(0, 0, 0, 0.3),
        0 0 0 6px rgba(var(--primary-lavender-rgb), 0.3);
}

.rangeInput::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--primary-lavender);
    cursor: pointer;
    border: none;
    box-shadow:
        0 2px 6px rgba(0, 0, 0, 0.2),
        0 0 0 4px rgba(var(--primary-lavender-rgb), 0.2);
    transition: all 0.2s;
}

.rangeInput::-moz-range-thumb:hover {
    transform: scale(1.2);
}

/* Text Content with Font Picker */
.textContent {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
}

.fontPicker {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
}

.fontBtn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2);
    border: 2px solid var(--border-default);
    background: var(--bg-primary);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s;
}

.fontBtn:hover {
    border-color: var(--primary-lavender);
    transform: translateY(-2px);
}

.fontBtn.active {
    border-color: var(--primary-lavender);
    background: rgba(var(--primary-lavender-rgb), 0.1);
    box-shadow: 0 2px 8px rgba(var(--primary-lavender-rgb), 0.2);
}

.fontPreview {
    font-size: 24px;
    font-weight: bold;
    color: var(--text-primary);
}

.fontName {
    font-size: 10px;
    color: var(--text-secondary);
    text-align: center;
}

.fontBtn.active .fontName {
    color: var(--primary-lavender);
    font-weight: 600;
}

.textInputRow {
    display: flex;
    gap: var(--space-2);
}

.textInput {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-full);
    border: 2px solid var(--border-default);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: var(--font-sm);
    transition: all 0.2s;
}

.textInput:focus {
    outline: none;
    border-color: var(--primary-lavender);
    box-shadow: 0 0 0 4px rgba(var(--primary-lavender-rgb), 0.1);
}

.overlayList {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}

.overlayListItem {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3);
    background: var(--bg-secondary);
    gap: var(--space-3);
    max-height: 100%;
    overflow-y: auto;
}

/* Audio Timeline Wrapper (Instagram-style under video timeline) */
.audioTimelineWrapper {
    padding: var(--space-3);
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-default);
    margin-bottom: var(--space-2);
}

.audioTimelineWrapper .trackInfo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) 0 var(--space-3) 0;
    margin-bottom: var(--space-2);
}

.audioTimelineWrapper .trackInfo span {
    font-size: var(--font-sm);
    color: var(--text-primary);
    font-weight: 600;
}

.audioTimelineWrapper .trackInfo button {
    background: none;
    border: none;
    color: var(--error);
    cursor: pointer;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    display: flex;
    align-items: center;
}

.audioTimelineWrapper .trackInfo button:hover {
    background: rgba(var(--error-rgb), 0.1);
    transform: scale(1.1);
}

.trackInfo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3);
    background: linear-gradient(135deg,
            rgba(var(--primary-lavender-rgb), 0.1) 0%,
            rgba(var(--primary-lavender-rgb), 0.05) 100%);
    border-radius: var(--radius-lg);
    border: 1px solid var(--primary-lavender);
}

.trackInfo span {

    .controls {
        width: 100%;
        height: 60vh;
    }

    .video {
        max-height: 35vh;
    }

    .filterGrid {
        grid-template-columns: repeat(4, 1fr);
    }

    .fontPicker {
        grid-template-columns: repeat(3, 1fr);
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .container {
            flex-direction: column;
        }

        .previewWrapper {
            width: 100%;
            height: 40vh;
        }

        .controls {
            width: 100%;
            height: 60vh;
        }

        .video {
            max-height: 35vh;
        }

        .filterGrid {
            grid-template-columns: repeat(4, 1fr);
        }

        .fontPicker {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 768px) {
        .filterGrid {
            grid-template-columns: repeat(3, 1fr);
        }

        .aspectRatioButtons {
            grid-template-columns: repeat(2, 1fr);
        }

        .fontPicker {
            grid-template-columns: repeat(2, 1fr);
        }
    }